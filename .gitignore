# =============================================================================
# TaskMaster — Git Ignore Configuration
# =============================================================================

# Dependency Directories
node_modules/
jspm_packages/
web_modules/

# Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Logs and Runtime Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database Local Dumps and Temporary Backups
# (database.sql is kept as the starter schema template)
*.dump
*.sql.bak
*.sql.gz
*.backup
*.sqlite
*.sqlite3
*.db

# Build Output & Temporary Directories
dist/
build/
out/
temp/
tmp/
.cache/
.parcel-cache/

# Editor & IDE-specific Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
# Local database dumps and sensitive SQL exports
database-dump.sql
*.dump.sql