{
  "name": "task-management-system",
  "version": "1.0.0",
  "description": "Full-stack Task Management System using Express, Drizzle ORM, MySQL, Bootstrap 5 and Tailwind CSS",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/style.css --watch",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node scripts/run-migration.js",
    "test": "node tests/sms-reminders.test.js"
  },
  "keywords": [
    "task-management",
    "express",
    "drizzle-orm",
    "mysql",
    "bootstrap",
    "tailwindcss"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "twilio": "^6.2.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17"
  }
}
