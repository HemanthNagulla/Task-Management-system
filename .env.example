# =============================================================================
# TaskMaster — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to GitHub or any public repository.
# =============================================================================

# Server Port
PORT=3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=task_management_db

# Application Default Timezone (IANA Format)
APP_TIMEZONE=Asia/Kolkata

# Twilio SMS Provider Credentials
# Obtain these from your Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Twilio Trial Account Configuration:
# Set to 'true' if testing on a free Twilio trial account to avoid Error 572006.
# Trial accounts are restricted from sending arbitrary custom reminder bodies.
TWILIO_TRIAL_MODE=false

# Supported predefined templates for trial mode:
# sms_appointment_reminders (default), sms_delivery_updates, sms_order_confirmation,
# sms_customer_support, sms_2fa, sms_marketing_promotions
TWILIO_TRIAL_TEMPLATE=sms_appointment_reminders

# Optional: Twilio Content SID (if using pre-approved Content API templates on upgraded accounts)
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
